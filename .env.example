# ---- Server ----
PORT=4173
SITE_NAME=PriceHub TH
SITE_ORIGIN=http://localhost:4173

# SubID ที่ผูกกับทุกลิงก์ Affiliate (สูงสุด 5 ช่อง ตามข้อกำหนด Shopee)
# รูปแบบที่ใช้จริง: ["<slot-1>","<category-slug>","<product-id>"]
AFFILIATE_SLOT_1=pricehub

# ---- Shopee Affiliate Open API (GraphQL) ----
# สมัคร/ขอ credential ได้ที่ https://affiliate.shopee.co.th/open_api
# เมื่อยังไม่ใส่ ระบบจะทำงานแบบ passthrough และแสดงสถานะ "ยังไม่ได้ตั้งค่า"
SHOPEE_APP_ID=
SHOPEE_SECRET=
SHOPEE_GRAPHQL_URL=https://open-api.affiliate.shopee.co.th/graphql

# ---- Lazada Affiliate ----
# Lazada ยังไม่เปิดเอกสาร API สร้างลิงก์ต่อสาธารณะ จึงรองรับ 2 วิธี:
#  (A) ใส่ URL ของ affiliate-network / deeplink ที่คุณได้รับอนุญาตมา
#      โดยใช้ placeholder {url} สำหรับปลายทางสินค้า เช่
#      https://your-network.com/aff/lazada?u={url}&subid1={subid1}
#  (B) ปล่อยว่างไว้ -> ระบบจะเปลี่ยนเส้นทางไปหน้าสินค้าโดยตรง (passthrough)
LAZADA_AFFILIATE_TEMPLATE=
LAZADA_AFFILIATE_API_URL=
LAZADA_AFFILIATE_API_KEY=

# ---- ราคาสด (Live price) ----
# เมื่อตั้งค่า endpoint นี้ ระบบจะขึ้นราคาจริงแทนราคาใน Early Catalog
# Contract: POST {url} -> { price: 2990, currency: "THB" }
PRICE_API_URL=
PRICE_API_KEY=